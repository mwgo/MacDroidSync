<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App extensions run sandboxed. The shared files arrive as security scoped
         URLs, so read only access to what the user picked is enough. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- The extension only needs to drop a request file where the app looks for
         it; the app itself, which is not sandboxed, reads the shared files. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/MacDroidSync/</string>
    </array>
</dict>
</plist>
