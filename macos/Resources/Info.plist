<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>MacDroidSync</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>pl.wojas.MacDroidSync</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MacDroidSync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu bar only application: no Dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown at the bottom of the About panel. -->
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Marcin Wojas</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>MacDroidSync saves the files you share from your Android phone into your Downloads folder.</string>
    <!-- Read and write access, not add-only: the photo sync has to look up what
         it has already imported and remove what you delete on the phone, and
         add-only cannot even fetch an asset. Missing this key does not deny the
         app, it terminates it. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>MacDroidSync adds the photos and videos from your Android phone to your Photos library, and removes the ones you delete on the phone once you confirm.</string>
    <!-- Without this key macOS refuses the Bluetooth LE scan the auto lock needs. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>MacDroidSync listens for the presence beacon of your Android phone so it can lock this Mac when you walk away.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacDroidSync needs the local network to send your clipboard to your Android phone over Wi-Fi.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_macdroidsync._tcp</string>
    </array>
    <!-- Adds "Send to Android" to the Services menu and to the Finder context
         menu whenever files are selected. Unlike the Share extension in
         Contents/PlugIns, this works with an ad-hoc signature. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Send to Android</string>
            </dict>
            <key>NSMessage</key>
            <string>sendToAndroid</string>
            <key>NSPortName</key>
            <string>MacDroidSync</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
                <string>NSFilenamesPboardType</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
