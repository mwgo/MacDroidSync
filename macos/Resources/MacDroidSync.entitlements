<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this, PhotoKit answers .authorized and then shows an empty
         library: no assets, no albums, no smart albums, no error. The grant is
         part of the code signature, so it has to be here rather than in
         Info.plist, and build.sh must pass this file to codesign.

         The app itself is deliberately not sandboxed. -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
    <!-- Apple events to Notes for the notes sync. Only enforced under the
         hardened runtime, which build.sh does not turn on, but there for the
         day it does. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
