# Template for android/keystore.properties, which signs release builds.
#
#   cp keystore.properties.example keystore.properties
#
# Copy it, do not move it - the template belongs in the repository, the copy never
# does. .gitignore excludes the copy because it holds the password to the key that
# proves a build came from you; anyone with both the keystore and these passwords
# can ship an update over the top of an installed MacDroidSync.
#
# Create the keystore first, somewhere outside this repository:
#
#   keytool -genkeypair -v -keystore ~/keys/macdroidsync.jks -alias macdroidsync \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# Keep a backup of it. Losing it means never being able to update an installed
# copy again - Android refuses an update signed by a different key.
#
# Then chmod 600 the copy: these values sit in it in plain text.
#
# Without the copy the release build still works; it just produces
# app-release-unsigned.apk, which no phone will install. A build server that
# cannot hold the file can pass the same values as the environment variables
# MDS_STORE_FILE, MDS_STORE_PASSWORD, MDS_KEY_ALIAS and MDS_KEY_PASSWORD.

# Absolute path, or relative to the android directory.
storeFile=/Users/you/keys/macdroidsync.jks
storePassword=
keyAlias=macdroidsync
# Leave empty when the key has no password of its own, which is the usual case:
# keytool offers "RETURN if same as keystore password" and most people take it.
keyPassword=
