<?xml version="1.0" encoding="utf-8"?>
<!-- Dark counterparts of the brand scheme in values/colors.xml. -->
<resources>
    <color name="brand_primary">#A9C7FF</color>
    <color name="brand_on_primary">#002F65</color>
    <color name="brand_primary_container">#00458F</color>
    <color name="brand_on_primary_container">#D6E3FF</color>
    <color name="brand_secondary_container">#3B4254</color>
    <color name="brand_on_secondary_container">#DCE2F9</color>
    <!-- Navy: when a note was last edited, on the notes list. -->
    <color name="note_edited">#9DB4F5</color>
    <!-- The dot before the title of a note not yet synced with the Mac. -->
    <color name="note_unsynced">#FFB06B</color>
    <!-- The icons of the groups on the notes list, the amber of Notes MD on the Mac. -->
    <color name="note_group_icon">#F0973A</color>
    <!-- A note, as Notes MD shows it on the Mac: the lowest headings and the date under the title. -->
    <color name="note_muted">#98989D</color>
    <color name="note_chevron">#6E6E73</color>
    <!-- The line under the title, and the bar of a quote. -->
    <color name="note_rule">#3A3532</color>
    <color name="note_quote_bar">#4A433C</color>
    <!-- Code within a line of text. -->
    <color name="note_code_background">#3A2E24</color>
    <color name="note_code_text">#FFC08A</color>
    <!-- The ring of a box not ticked, and the tick on the amber of one ticked. -->
    <color name="note_box">#636366</color>
    <color name="note_tick">#1E1E1E</color>
</resources>
