<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the picture takes the screen; the controls float on it, translucent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <pl.mwgo.macdroidsync.CropView
        android:id="@+id/crop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/cancel"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_editor_overlay"
        android:contentDescription="@string/photos_cancel"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_editor_overlay"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#D9FFC107"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/editor_overwrite"
            android:textColor="#FF202124" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveCopy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/editor_save_copy"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/aspect"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_aspect"
                android:src="@drawable/ic_aspect_ratio"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/free"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_free"
                android:src="@drawable/ic_crop_free"
                app:tint="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- The ruler, with a quarter turn either way at its ends. -->
    <LinearLayout
        android:id="@+id/turnBar"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_editor_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/rotateLeft"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_rotate_left"
            android:src="@drawable/ic_rotate_left"
            app:tint="#FFFFFFFF" />

        <pl.mwgo.macdroidsync.AngleRuler
            android:id="@+id/ruler"
            android:layout_width="320dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/rotateRight"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_rotate_right"
            android:src="@drawable/ic_rotate_right"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

    <!-- In place of the ruler: the frame's proportions to choose from. -->
    <HorizontalScrollView
        android:id="@+id/ratioBar"
        android:layout_width="416dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_editor_overlay"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ratios"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
