<!--
  Launcher icon of the Markdown notes: a notepad in the style of the Notes app
  on the Mac, a white sheet with a yellow band across its top and ruled lines,
  on the same blue as the MacDroidSync icon, so that the two read as a pair.
  The background is a full square on purpose: the launcher applies its own
  shape mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:fillColor="#1B6AC9"
        android:pathData="M0,0h1024v1024h-1024z" />
    <!-- A soft shadow under the sheet. -->
    <path
        android:fillColor="#33000000"
        android:pathData="M342,232h356a72,72 0 0 1 72,72v456a72,72 0 0 1 -72,72h-356a72,72 0 0 1 -72,-72v-456a72,72 0 0 1 72,-72z" />
    <!-- The sheet. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M334,212h356a72,72 0 0 1 72,72v456a72,72 0 0 1 -72,72h-356a72,72 0 0 1 -72,-72v-456a72,72 0 0 1 72,-72z" />
    <!-- The yellow band, rounded where the sheet is. -->
    <path
        android:fillColor="#FFC933"
        android:pathData="M334,212h356a72,72 0 0 1 72,72v74h-500v-74a72,72 0 0 1 72,-72z" />
    <!-- The perforation between the band and the page. -->
    <path
        android:fillColor="#E0A91A"
        android:pathData="M262,352h500v12h-500z" />
    <!-- Ruled lines. -->
    <path
        android:strokeColor="#C9D2DE"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:pathData="M326,462H698 M326,552H698 M326,642H698 M326,732H560" />
</vector>
