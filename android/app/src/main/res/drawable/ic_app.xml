<!--
  Launcher icon, the same artwork as the macOS application icon
  (macos/Resources/AppIcon.svg): two arrows, one above the other, pointing
  opposite ways. The clipboard, the files and the presence all travel in both
  directions, which a clipboard glyph never said.

  The viewport is 1024 so the coordinates can be shared with the SVG verbatim.
  The corners are rounded by stroking the outline in the fill colour, which is
  why the shafts are drawn 24 units thinner than they look. The background is a
  full square on purpose: the launcher applies its own shape mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:fillColor="#1B6AC9"
        android:pathData="M0,0h1024v1024h-1024z" />
    <!-- Scaled about the centre to give the glyph the same presence on the icon
         as the clipboard it replaces. -->
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="1.25"
        android:scaleY="1.25">
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="24"
            android:strokeLineJoin="round"
            android:pathData="M232,384 L412,284 L412,350 L792,350 L792,418 L412,418 L412,484 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="24"
            android:strokeLineJoin="round"
            android:pathData="M792,640 L612,540 L612,606 L232,606 L232,674 L612,674 L612,740 Z" />
    </group>
</vector>
