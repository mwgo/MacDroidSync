<?xml version="1.0" encoding="utf-8"?>
<!-- The notes, in folders, as tiles. It is padded clear of the status bar in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- The page takes the focus the search field gives up, so the list opens without the keyboard. -->


    <!-- Searching looks through the whole text of every note. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_search">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="?attr/colorOnSurfaceVariant"
            android:hint="@string/notes_search"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="44dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <ImageButton
            android:id="@+id/searchClear"
            style="@style/NoteTool.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/notes_search_clear"
            android:padding="10dp"
            android:src="@drawable/ic_tool_close"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The insets pad this column, keeping the toolbar above the navigation bar. -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/noResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:paddingTop="48dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/toolNewFolder"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_new_folder"
                android:src="@drawable/ic_folder_new"
                android:tooltipText="@string/notes_new_folder" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/toolFoldFolders"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_fold_folders"
                android:src="@drawable/ic_tool_fold"
                android:tooltipText="@string/notes_fold_folders" />

            <ImageButton
                android:id="@+id/toolFolders"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_folders_on"
                android:src="@drawable/ic_folders"
                android:tooltipText="@string/notes_folders_on" />

            <ImageButton
                android:id="@+id/toolSort"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_sorted_modified"
                android:src="@drawable/ic_sort_modified"
                android:tooltipText="@string/notes_sorted_modified" />

            <ImageButton
                android:id="@+id/toolView"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_view_list"
                android:src="@drawable/ic_view_list"
                android:tooltipText="@string/notes_view_list" />

            <ImageButton
                android:id="@+id/toolTheme"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_theme_dark"
                android:src="@drawable/ic_theme_dark"
                android:tooltipText="@string/notes_theme_dark" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/toolNewNote"
                style="@style/NoteTool.Icon"
                android:contentDescription="@string/notes_new_note"
                android:src="@drawable/ic_note_new"
                android:tooltipText="@string/notes_new_note" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
