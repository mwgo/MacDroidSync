<?xml version="1.0" encoding="utf-8"?>
<!-- A folder of the notes list: tap to fold it, hold for renaming or deleting it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:contentDescription="@string/notes_fold_hint"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="14dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder_chevron"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_group_folder"
        app:tint="@color/note_group_icon" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />


    <ImageButton
        android:id="@+id/add"
        style="@style/NoteTool.Icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/notes_new_note_here"
        android:padding="9dp"
        android:src="@drawable/ic_folder_add_note"
        android:tooltipText="@string/notes_new_note_here" />
</LinearLayout>
