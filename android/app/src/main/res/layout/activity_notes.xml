<?xml version="1.0" encoding="utf-8"?>
<!-- The page, and over it the picture shown on the whole screen, which also
     covers the status bar the page keeps clear of. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- The root takes the focus the field gives up, so that hiding the caret
         sticks and the note opens without one. It is padded clear of the status
         bar in code, as there is no app bar above the note to do it. -->


    <!-- The insets pad this column, which puts the toolbar above the keyboard
         and the navigation bar while the field keeps its own padding. -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/noteFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- The field grows with the note and this scrolls it: a text field's own
             scrolling stops dead when the finger lifts, this one flings. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/editorScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <!-- saveEnabled is off because the field would restore its text without
                 the spans that make up the note; the activity saves Markdown instead. -->
            <pl.wojas.macdroidsync.MarkdownEditText
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="4dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:saveEnabled="false"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </androidx.core.widget.NestedScrollView>

        <!-- The note's title, kept at the top once the note is scrolled past it. -->
        <LinearLayout
            android:id="@+id/stickyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/stickyTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="28dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />
        </LinearLayout>
            <!-- One table over the whole note, a grid of fields scrolling both ways. It
                 grows out of the table in the note, which shows beneath it meanwhile. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/tableScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:fillViewport="true"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:clipToPadding="false">

                    <pl.wojas.macdroidsync.TableGrid
                        android:id="@+id/tableGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>

            <!-- A drawing being made, over the whole note like a table. -->
            <FrameLayout
                android:id="@+id/drawingScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:visibility="gone" />
        </FrameLayout>

        <!-- The Markdown source, plain text in place of the formatted note. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sourceScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp"
                android:saveEnabled="false"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:ignore="LabelFor" />
        </androidx.core.widget.NestedScrollView>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/toolsScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <!-- While reading only the fold button shows; while editing only the rest. -->
            <LinearLayout
                android:id="@+id/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <ImageButton
                    android:id="@+id/toolFoldAll"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_fold_all"
                    android:src="@drawable/ic_tool_fold"
                    android:tooltipText="@string/tool_fold_all" />

                <ImageButton
                    android:id="@+id/toolTableDone"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_done"
                    android:src="@drawable/ic_tool_done"
                    android:tooltipText="@string/table_done" />

                <ImageButton
                    android:id="@+id/toolRowAdd"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_add_row"
                    android:src="@drawable/ic_tool_row_add"
                    android:tooltipText="@string/table_add_row" />

                <ImageButton
                    android:id="@+id/toolColumnAdd"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_add_column"
                    android:src="@drawable/ic_tool_column_add"
                    android:tooltipText="@string/table_add_column" />

                <ImageButton
                    android:id="@+id/toolMoveUp"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_move_up"
                    android:src="@drawable/ic_tool_move_up"
                    android:tooltipText="@string/table_move_up" />

                <ImageButton
                    android:id="@+id/toolMoveDown"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_move_down"
                    android:src="@drawable/ic_tool_move_down"
                    android:tooltipText="@string/table_move_down" />

                <ImageButton
                    android:id="@+id/toolMoveLeft"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_move_left"
                    android:src="@drawable/ic_tool_move_left"
                    android:tooltipText="@string/table_move_left" />

                <ImageButton
                    android:id="@+id/toolMoveRight"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_move_right"
                    android:src="@drawable/ic_tool_move_right"
                    android:tooltipText="@string/table_move_right" />

                <ImageButton
                    android:id="@+id/toolRowRemove"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_remove_row"
                    android:src="@drawable/ic_tool_row_remove"
                    android:tooltipText="@string/table_remove_row" />

                <ImageButton
                    android:id="@+id/toolColumnRemove"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_remove_column"
                    android:src="@drawable/ic_tool_column_remove"
                    android:tooltipText="@string/table_remove_column" />

                <ImageButton
                    android:id="@+id/toolTableDelete"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/table_delete"
                    android:src="@drawable/ic_tool_delete"
                    android:tooltipText="@string/table_delete" />

                <ImageButton
                    android:id="@+id/toolCloseMarkdown"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/notes_close_markdown"
                    android:src="@drawable/ic_tool_close"
                    android:tooltipText="@string/notes_close_markdown" />

                <ImageButton
                    android:id="@+id/toolShowMarkdown"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/notes_show_markdown"
                    android:src="@drawable/ic_tool_markdown"
                    android:tooltipText="@string/notes_show_markdown" />

                <ImageButton
                    android:id="@+id/toolPin"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_pin"
                    android:src="@drawable/ic_tool_pin"
                    android:tooltipText="@string/note_pin" />

                <ImageButton
                    android:id="@+id/toolMoveNote"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_move"
                    android:src="@drawable/ic_tool_folder_move"
                    android:tooltipText="@string/note_move" />

                <ImageButton
                    android:id="@+id/toolCopyNote"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_copy"
                    android:src="@drawable/ic_tool_copy"
                    android:tooltipText="@string/note_copy" />

                <!-- A note in the trash is only read; it can be restored or deleted for good. -->
                <ImageButton
                    android:id="@+id/toolRestore"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_restore"
                    android:src="@drawable/ic_tool_undo"
                    android:tooltipText="@string/note_restore" />

                <ImageButton
                    android:id="@+id/toolDeleteForever"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_delete_forever"
                    android:src="@drawable/ic_tool_delete"
                    android:tooltipText="@string/note_delete_forever" />

                <ImageButton
                    android:id="@+id/toolDeleteNote"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/note_delete"
                    android:src="@drawable/ic_tool_delete"
                    android:tooltipText="@string/note_delete" />

                <ImageButton
                    android:id="@+id/toolInsert"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_insert"
                    android:src="@drawable/ic_tool_insert"
                    android:tooltipText="@string/tool_insert" />

                <TextView
                    android:id="@+id/toolBold"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_bold"
                    android:text="B"
                    android:textStyle="bold"
                    android:tooltipText="@string/tool_bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/toolItalic"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_italic"
                    android:fontFamily="serif"
                    android:text="I"
                    android:textStyle="italic"
                    android:tooltipText="@string/tool_italic"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/toolUnderline"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_underline"
                    android:text="U"
                    android:tooltipText="@string/tool_underline"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/toolCode"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_code"
                    android:fontFamily="monospace"
                    android:text="&lt;/&gt;"
                    android:textSize="15sp"
                    android:tooltipText="@string/tool_code"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/toolCodeBlock"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_code_block"
                    android:fontFamily="monospace"
                    android:text="{ }"
                    android:textSize="15sp"
                    android:tooltipText="@string/tool_code_block"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/toolHeading"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_heading"
                    android:text="H"
                    android:textStyle="bold"
                    android:tooltipText="@string/tool_heading"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/toolBullets"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_bullets"
                    android:src="@drawable/ic_tool_bullets"
                    android:tooltipText="@string/tool_bullets" />

                <TextView
                    android:id="@+id/toolNumbered"
                    style="@style/NoteTool"
                    android:contentDescription="@string/tool_numbered"
                    android:text="1."
                    android:tooltipText="@string/tool_numbered"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/toolCheckbox"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_checkbox"
                    android:src="@drawable/ic_tool_checkbox"
                    android:tooltipText="@string/tool_checkbox" />

                <ImageButton
                    android:id="@+id/toolQuote"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_quote"
                    android:src="@drawable/ic_tool_quote"
                    android:tooltipText="@string/tool_quote" />


                <!-- The insert toolbar: the way back to formatting, then what can be inserted. -->
                <ImageButton
                    android:id="@+id/toolInsertClose"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_insert_close"
                    android:src="@drawable/ic_tool_close"
                    android:tooltipText="@string/tool_insert_close" />

                <ImageButton
                    android:id="@+id/toolTable"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/notes_insert_table"
                    android:src="@drawable/ic_tool_table"
                    android:tooltipText="@string/notes_insert_table" />

                <ImageButton
                    android:id="@+id/toolImageGallery"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_image_gallery"
                    android:src="@drawable/ic_tool_gallery"
                    android:tooltipText="@string/tool_image_gallery" />

                <ImageButton
                    android:id="@+id/toolImageCamera"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_image_camera"
                    android:src="@drawable/ic_tool_camera"
                    android:tooltipText="@string/tool_image_camera" />

                <ImageButton
                    android:id="@+id/toolDrawing"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_drawing"
                    android:src="@drawable/ic_tool_draw"
                    android:tooltipText="@string/tool_drawing" />

                <ImageButton
                    android:id="@+id/toolFile"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_file"
                    android:src="@drawable/ic_tool_attach"
                    android:tooltipText="@string/tool_file" />

                <ImageButton
                    android:id="@+id/toolRecord"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/tool_record"
                    android:src="@drawable/ic_tool_mic"
                    android:tooltipText="@string/tool_record" />

                <!-- While recording: discard, how long so far, and stop keeping it. -->
                <ImageButton
                    android:id="@+id/toolRecordCancel"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/record_cancel"
                    android:src="@drawable/ic_tool_close"
                    android:tooltipText="@string/record_cancel" />

                <TextView
                    android:id="@+id/recordTime"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="12dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <ImageButton
                    android:id="@+id/toolRecordStop"
                    style="@style/NoteTool.Icon"
                    android:contentDescription="@string/record_stop"
                    android:src="@drawable/ic_tool_stop"
                    android:tooltipText="@string/record_stop" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- While reading, how many tasks the note has and how many are left. -->
        <TextView
            android:id="@+id/taskCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <FrameLayout
        android:id="@+id/imageViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
